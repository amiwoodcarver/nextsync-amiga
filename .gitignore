# Build products
*.o
/NextSync

# Cross toolchain (tools/build-toolchain.sh) and its source tree
/toolchain
/build

# AmiSSL SDK and runtime (tools/fetch-deps.sh)
/vendor

# Copyrighted Commodore material, supplied by whoever clones this
/kickstarts
*.rom
*.adf
*.ADF
*.lha
*.7z

# Emulator state: hd0 is a Workbench install with build output dropped in,
# the machine configs are generated by tools/emu-config.sh, and mockdav is
# whatever you put in front of tools/mockdav.py
/emu/hd0
/emu/configs/*.uae
/emu/mockdav

# Credentials: this holds a server password in plain text
NextSync.conf
!NextSync.conf.example

# Host junk
.DS_Store
*.uaem
*.nspart
.nextsync.state

# Aminet distribution, built by tools/mkdist.sh
/dist
